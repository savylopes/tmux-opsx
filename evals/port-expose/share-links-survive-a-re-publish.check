#!/usr/bin/env bash
# scenario: port-expose / Share links survive a re-publish
# level: L2
# requirement: Re-publishing a name
set -u
. "$EVAL_ROOT/evals/_lib/expose.sh"; . "$EVAL_ROOT/evals/_lib/proxy.sh"
proxy_setup; start_app old; O=$APP_PORT; start_app new; N=$APP_PORT
x up "$O" --name web >/dev/null || fail "up failed"
t=$(x share web --for acme | tail -n1 | sed -n 's/.*opsx_share=//p'); [ -n "$t" ] || fail "no share link"
x up "$N" --name web >/dev/null || fail "re-publish failed"
req web--shop "/?opsx_share=$t"; echo "acme link -> $CODE"; [ "$CODE" = 302 ] || fail "link got $CODE"
req web--shop / -H "Cookie: opsx_share=$t"; echo "acme cookie -> $CODE $BODY"
[ "$CODE" = 200 ] && [ "$BODY" = app:new ] || fail "link does not reach the app on the new port"
echo OK
