#!/usr/bin/env bash
# scenario: port-expose / Warning shown
# level: L2
# requirement: Public access warning
set -u
. "$EVAL_ROOT/evals/_lib/expose.sh"
configure_expose; start_admin "$(caddy_json)"; mkdir -p "$EVAL_TMP/shop"; cd "$EVAL_TMP/shop" || exit 1
o=$(x up 3000 2>&1); rc=$?; echo "exit $rc"; echo "$o"
[ "$rc" -eq 0 ] || fail "up exited $rc"
n=$(echo "$o" | grep -niE 'public' | grep -iE 'no auth|without auth|unauthenticated' | head -1 | cut -d: -f1)
[ -n "$n" ] || fail "no line saying the URL is public with no authentication"
[ "$n" -lt "$(echo "$o" | wc -l)" ] || fail "warning is not before the URL line"
echo OK
