#!/usr/bin/env bash
# scenario: port-expose / Share links do not come back
# level: L2
# requirement: Remove an exposure
set -u
. "$EVAL_ROOT/evals/_lib/expose.sh"; . "$EVAL_ROOT/evals/_lib/proxy.sh"
proxy_setup; start_app web
x up "$APP_PORT" --name web >/dev/null || fail "up failed"
t=$(x share web --for acme | tail -n1 | sed -n 's/.*opsx_share=//p'); [ -n "$t" ] || fail "no share link"
x down web >/dev/null || fail "down failed"
x up "$APP_PORT" --name web >/dev/null || fail "second up failed"
req web--shop "/?opsx_share=$t"; echo "old link -> $CODE"; [ "$CODE" = 401 ] || fail "old link got $CODE"
l=$(x share web --list 2>&1); echo "$l"
case "$l" in *opsx_share=*|*acme*) fail "share --list still shows links";; esac
echo OK
