#!/usr/bin/env bash
# scenario: dev-container / Exit status and workdir
# level: L1
# requirement: Commands run as the user in the same directory
set -u
. "$EVAL_ROOT/evals/_lib/dev.sh"
mk_repo; mk_worktree
devyaml "$WT" "image: golang:1.22"
mkdir -p "$WT/pkg"
export FAKE_DOCKER_EXIT_CMD=go FAKE_DOCKER_EXIT=3
OD_CWD=$WT/pkg od go test ./pkg; echo "exit $rc"; echo "$out"
[ "$rc" -eq 3 ] || fail "expected exit 3, got $rc"
python3 -I - "$DLOG" "$(id -u):$(id -g)" "$WT/pkg" "$(cd "$WT/pkg" && pwd -P)" <<'PY' || exit 1
import json, sys
log, ug, w1, w2 = sys.argv[1:5]
ex = [json.loads(l) for l in open(log)]; ex = [e for e in ex if e[:1] == ["exec"] and "test" in e]
if not ex: print("FAIL: no exec of go test"); sys.exit(1)
e = ex[-1]; print(e)
def val(f): return [e[i+1] for i in range(len(e)-1) if e[i] == f]
if ug not in val("-u"): print("FAIL: -u %s missing" % ug); sys.exit(1)
if not (set(val("-w")) & {w1, w2}): print("FAIL: -w %s missing" % w1); sys.exit(1)
if e[-3:] != ["go", "test", "./pkg"]: print("FAIL: args not separate words: %s" % e[-3:]); sys.exit(1)
print("OK")
PY
