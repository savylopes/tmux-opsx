#!/usr/bin/env bash
# scenario: dev-container / Unknown key
# level: L1
# requirement: dev.yaml keys
set -u
. "$EVAL_ROOT/evals/_lib/dev.sh"
mk_repo; mk_worktree
devyaml "$WT" "image: golang:1.22" "colour: blue"
od true
echo "exit $rc"; echo "$out"
[ "$rc" -eq 0 ] || fail "expected the command to run (exit 0), got $rc"
echo "$out" | grep -q colour || fail "no warning naming colour"
[ "$(dcount exec)" -ge 1 ] || fail "command never ran via docker exec"
echo OK
