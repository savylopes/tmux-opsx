#!/usr/bin/env bash
# scenario: ops-eval / Removed scenario loses its check
# level: L3
# requirement: Checks are generated from spec scenarios
set -u
. "$EVAL_ROOT/evals/_lib/agent.sh"
l3_require
mk_repo
# Main also has requirement Wave with a check.
cat >> "$REPO/openspec/specs/greet/spec.md" <<'S'

### Requirement: Wave
`greet.sh --wave` SHALL print `wave`.

#### Scenario: Waves
- **WHEN** `sh greet.sh --wave` runs
- **THEN** it prints `wave`
S
sed -i '2i [ "$1" = --wave ] && { echo wave; exit 0; }' "$REPO/greet.sh"
mkdir -p "$REPO/evals/greet"
printf '#!/usr/bin/env bash\n# scenario: greet / Says hello\n# level: L1\nsh "$EVAL_ROOT/greet.sh" | grep -qx hello\n' > "$REPO/evals/greet/says-hello.check"
printf '#!/usr/bin/env bash\n# scenario: greet / Waves\n# level: L1\nsh "$EVAL_ROOT/greet.sh" --wave | grep -qx wave\n' > "$REPO/evals/greet/waves.check"
chmod +x "$REPO"/evals/greet/*.check; printf 'timeout: 30\n' > "$REPO/evals/eval.yaml"
g add -A; g commit -qm "wave + checks"
start_change drop-wave
delta greet '## REMOVED Requirements

### Requirement: Wave
**Reason**: Nobody waves.
**Migration**: None.'
sed -i '/--wave/d' "$REPO/greet.sh"
commit_change
run_agent opsx-eval.md "$(eval_prompt)"
[ ! -e "$REPO/evals/greet/waves.check" ] || fail "evals/greet/waves.check still exists after Wave was removed"
[ -e "$REPO/evals/greet/says-hello.check" ] || fail "unrelated check evals/greet/says-hello.check was deleted"
echo "OK"
