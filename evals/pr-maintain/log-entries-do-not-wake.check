#!/usr/bin/env bash
# scenario: pr-maintain / Log entries do not wake
# level: L1
# requirement: Peer event from the ledger
set -u
. "$EVAL_ROOT/evals/_lib/pr.sh"
mk_stack_env; seed 41; seed 42 41
tell_ok 41 log doing
out=$(pr wait 42 --slice 2 --poll 1 2>&1); rc=$?; echo "$out"; echo "exit $rc"
[ $rc -eq 3 ] || fail "expected exit 3, got $rc"
echo OK
