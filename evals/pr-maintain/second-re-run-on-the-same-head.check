#!/usr/bin/env bash
# scenario: pr-maintain / Second re-run on the same head
# level: L1
# requirement: Re-run a failed CI once per head
set -u
. "$EVAL_ROOT/evals/_lib/pr.sh"

ck() { printf "%s\n" "$1" > "$GHD/checks/42.json"; }
B() { printf "[{\"bucket\":\"%s\",\"link\":\"%s\"}" "$1" "$2"; }
wt() { out=$("$PRSH" wait 42 --slice "${1:-3}" --poll 1 --repo "$R" 2>&1); rc=$?; echo "$out"; echo "exit $rc"; }
seen() { "$PRSH" seen 42 --repo "$R" >/dev/null 2>&1 || fail "seen failed"; }
PASS='[{"bucket":"pass","link":""}]'
FAILC='[{"bucket":"fail","link":"https://github.com/o/app/actions/runs/77/job/1"}]'


mk_env
ck "$PASS"; seen; ck "$FAILC"
"$PRSH" rerun 42 --repo "$R" >/dev/null 2>&1 || fail "first rerun failed"
n=$(grep -c "^run rerun" "$GHD/gh.log")
"$PRSH" rerun 42 --repo "$R"; rc=$?
[ $rc -eq 6 ] || fail "expected exit 6, got $rc"
[ "$(grep -c "^run rerun" "$GHD/gh.log")" = "$n" ] || fail "second call ran gh run rerun"
echo OK
