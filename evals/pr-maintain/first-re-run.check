#!/usr/bin/env bash
# scenario: pr-maintain / First re-run
# level: L1
# requirement: Re-run a failed CI once per head
set -u
. "$EVAL_ROOT/evals/_lib/pr.sh"

ck() { printf "%s\n" "$1" > "$GHD/checks/42.json"; }
B() { printf "[{\"bucket\":\"%s\",\"link\":\"%s\"}" "$1" "$2"; }
wt() { out=$("$PRSH" wait 42 --slice "${1:-3}" --poll 1 --repo "$R" 2>&1); rc=$?; echo "$out"; echo "exit $rc"; }
seen() { "$PRSH" seen 42 --repo "$R" >/dev/null 2>&1 || fail "seen failed"; }
PASS='[{"bucket":"pass","link":""}]'
FAILC='[{"bucket":"fail","link":"https://github.com/o/app/actions/runs/77/job/1"}]'


mk_env
ck "$PASS"; seen
ck "[{\"bucket\":\"fail\",\"link\":\"https://github.com/o/app/actions/runs/77/job/1\"},{\"bucket\":\"cancel\",\"link\":\"https://github.com/o/app/actions/runs/78/job/2\"}]"
"$PRSH" rerun 42 --repo "$R"; rc=$?
[ $rc -eq 0 ] || fail "expected exit 0, got $rc"
grep -qx "run rerun 77 --failed.*" "$GHD/gh.log" || fail "no rerun of 77"
grep -qx "run rerun 78 --failed.*" "$GHD/gh.log" || fail "no rerun of 78"
grep -qx "rerun_head=$SHA_A" "$(state_file 42)" || fail "rerun_head not recorded: $(cat "$(state_file 42)")"
echo OK
