#!/usr/bin/env bash
# scenario: pr-maintain / Children found
# level: L2
# requirement: Resolve the PR's stack
set -u
. "$EVAL_ROOT/evals/_lib/pr.sh"
need_tmux; mk_stack_env
out=$(start_stack 41 2>&1); rc=$?; echo "$out"; echo "exit $rc"
[ $rc -eq 0 ] || fail "start exit $rc"
echo "$out" | grep -qx "stack parent=- children=42" || fail "no 'stack parent=- children=42' line"
echo OK
