#!/usr/bin/env bash
# scenario: pr-maintain / Task output read allowed, nothing else
# level: L1
# requirement: Monitor command guard
set -u
. "$EVAL_ROOT/evals/_lib/pr.sh"
need_tools
G_=$EVAL_ROOT/skills/opsx-pr/monitor-guard.sh
[ -x "$G_" ] || fail "monitor-guard.sh missing or not executable"
f=/tmp/claude-1000/-home-u-p/0a1b-2c/tasks/bq7x.output
run() { jq -nc --arg c "$1" '{tool_name:"Bash",tool_input:{command:$c}}' | "$G_" 2>&1 >/dev/null; }
for c in "tail -n 5 $f" "cat $f"; do
  err=$(run "$c"); rc=$?; echo "[$c] -> $rc $err"; [ $rc -eq 0 ] || fail "expected exit 0 for: $c"
done
for c in "cat /etc/passwd" "tail -f $f" "tail -n 5 /tmp/claude-1000/-home-u-p/0a1b-2c/tasks/../../../../etc/passwd"; do
  err=$(run "$c"); rc=$?; echo "[$c] -> $rc $err"; [ $rc -eq 2 ] || fail "expected exit 2 for: $c"
done
echo OK
