#!/usr/bin/env bash
# scenario: pr-maintain / Moved without SHAs
# level: L1
# requirement: Request carries a reference
set -u
. "$EVAL_ROOT/evals/_lib/pr.sh"
mk_stack_env; seed 41
pr tell 41 all moved; rc=$?; echo "exit $rc"
[ $rc -eq 2 ] || fail "expected exit 2, got $rc"
[ "$(n_entries)" = 0 ] || fail "a file was written"
echo OK
