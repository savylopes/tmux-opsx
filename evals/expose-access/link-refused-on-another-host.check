#!/usr/bin/env bash
# scenario: expose-access / Link refused on another host
# level: L2
# requirement: Share link scope
set -u
. "$EVAL_ROOT/evals/_lib/expose.sh"; . "$EVAL_ROOT/evals/_lib/proxy.sh"
proxy_setup; start_app web; WP=$APP_PORT; start_app api; AP=$APP_PORT
x up "$WP" --name web >/dev/null && x up "$AP" --name api >/dev/null || fail "up failed"
t=$(x share web --for acme | tail -n1 | sed -n 's/.*opsx_share=//p'); [ -n "$t" ] || fail "no share link"
req api--shop "/?opsx_share=$t"; echo "api with web token as query -> $CODE"; q=$CODE
req api--shop / -H "Cookie: opsx_share=$t"; echo "api with web token as cookie -> $CODE"; c=$CODE
[ "$q" = 401 ] || fail "query: expected 401, got $q"
[ "$c" = 401 ] || fail "cookie: expected 401, got $c"
[ "$(app_hits api)" = 0 ] || fail "api app was reached"
echo OK
