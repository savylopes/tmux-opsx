#!/usr/bin/env bash
# scenario: expose-access / No cookie
# level: L2
# requirement: Login required
set -u
. "$EVAL_ROOT/evals/_lib/expose.sh"; . "$EVAL_ROOT/evals/_lib/proxy.sh"
proxy_setup; start_app web
x up "$APP_PORT" --name web >/dev/null || fail "up failed"
req web--shop /; echo "no cookie -> $CODE"
[ "$CODE" = 401 ] || fail "expected 401, got $CODE"
n=$(app_hits web); [ "$n" = 0 ] || fail "app received $n request(s)"
echo OK
