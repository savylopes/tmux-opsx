#!/usr/bin/env bash
# scenario: expose-access / Same recipient replaced
# level: L2
# requirement: Share links
set -u
. "$EVAL_ROOT/evals/_lib/expose.sh"; . "$EVAL_ROOT/evals/_lib/proxy.sh"
proxy_setup; start_app web
x up "$APP_PORT" --name web >/dev/null || fail "up failed"
t1=$(x share web --for acme | tail -n1 | sed -n 's/.*opsx_share=//p')
t2=$(x share web --for acme | tail -n1 | sed -n 's/.*opsx_share=//p')
[ -n "$t1" ] && [ -n "$t2" ] || fail "share did not print links"
[ "$t1" != "$t2" ] || fail "both links have the same token"
req web--shop "/?opsx_share=$t1"; echo "first link -> $CODE"; c1=$CODE
req web--shop "/?opsx_share=$t2"; echo "second link -> $CODE"; c2=$CODE
[ "$c1" = 401 ] || fail "first link got $c1, expected 401"
[ "$c2" = 302 ] || [ "$c2" = 200 ] || fail "second link got $c2, expected accepted"
echo OK
