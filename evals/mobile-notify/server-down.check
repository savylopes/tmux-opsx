#!/usr/bin/env bash
# scenario: mobile-notify / Server down
# level: L1
# requirement: Push failures never break the caller
set -u
. "$EVAL_ROOT/evals/_lib/notify.sh"
write_notify_env
export FAKE_CURL_RC=7
out=$(bash "$NOTIFY_SH" finished "t" "b" 2>&1); rc=$?; echo "rc=$rc out=[$out]"
[ "$rc" -eq 0 ] || fail "expected exit 0, got $rc"
[ "$(curl_calls)" -ge 1 ] || fail "curl was never tried"
echo OK
