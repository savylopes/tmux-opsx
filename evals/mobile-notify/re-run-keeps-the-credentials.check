#!/usr/bin/env bash
# scenario: mobile-notify / Re-run keeps the credentials
# level: L2
# requirement: ntfy credentials
set -u
. "$EVAL_ROOT/evals/_lib/notify.sh"
notify_install_ok dev.example.com
[ -f "$NOTIFY_ENV" ] || fail "setup: notify.env not written"
t1=$(grep '^NTFY_TOKEN=' "$NOTIFY_ENV"); p1=$(grep '^NTFY_TOPIC=' "$NOTIFY_ENV"); echo "$p1"
[ -n "${t1#NTFY_TOKEN=}" ] && [ -n "${p1#NTFY_TOPIC=}" ] || fail "token or topic empty after first install"
notify_install_ok dev.example.com
t2=$(grep '^NTFY_TOKEN=' "$NOTIFY_ENV"); p2=$(grep '^NTFY_TOPIC=' "$NOTIFY_ENV")
[ "$t1" = "$t2" ] || fail "NTFY_TOKEN changed on re-run"
[ "$p1" = "$p2" ] || fail "NTFY_TOPIC changed on re-run"
n=$(grep -cE '^ntfy user .*add opsx$' "$FAKE_NTFY_LOG"); echo "user add opsx calls: $n"
[ "$n" -eq 1 ] || fail "expected exactly one 'ntfy user add opsx', got $n"
n=$(grep -cE '^ntfy user .*add' "$FAKE_NTFY_LOG"); echo "user add calls in total: $n"
[ "$n" -le 2 ] || fail "a second run created extra users ($n adds in total, expected the 2 of the first run)"
echo OK
