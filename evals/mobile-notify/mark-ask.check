#!/usr/bin/env bash
# scenario: mobile-notify / Mark ask
# level: L2
# requirement: Push when a decision is needed
set -u
. "$EVAL_ROOT/evals/_lib/notify.sh"
write_notify_env; start_tmux
read -r w p < <(new_win pr-42 change)
out=$(TMUX_PANE=$p bash "$WINSH" mark pr-42 ask 2>&1); rc=$?; echo "rc=$rc out=[$out]"
[ "$rc" -eq 0 ] || fail "mark exit $rc"
wait_calls 1 20 || fail "no push within 20 s"
sleep 2; n=$(curl_calls); [ "$n" -eq 1 ] || fail "expected one message, got $n"
curl_all_headers
curl_all_headers | grep -i '^Title:' | grep -q 'pr-42' || fail "title does not contain pr-42"
echo OK
