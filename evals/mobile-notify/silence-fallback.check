#!/usr/bin/env bash
# scenario: mobile-notify / Silence fallback
# level: L2
# requirement: Push when a window goes silent
set -u
. "$EVAL_ROOT/evals/_lib/notify.sh"
write_notify_env; start_tmux
read -r w p < <(new_win fix-x change)
TMUX_PANE=$p bash "$WINSH" mark fix-x busy >/dev/null 2>&1 || fail "mark busy failed"
[ "$(curl_calls)" -eq 0 ] || fail "busy pushed"
out=$(TMUX_PANE=$p bash "$WINSH" mark fix-x idle --if-busy 2>&1); echo "$out"
wait_calls 1 15 || fail "no push on the silence fallback"
sleep 2; n=$(curl_calls); [ "$n" -eq 1 ] || fail "expected one message, got $n"
{ curl_all_headers; curl_all_bodies; } | grep -qi 'without marking' || { curl_all_headers; curl_all_bodies; fail "message does not say the window stopped without marking"; }
echo OK
