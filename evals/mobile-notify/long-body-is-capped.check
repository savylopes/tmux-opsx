#!/usr/bin/env bash
# scenario: mobile-notify / Long body is capped
# level: L1
# requirement: Send a push without breaking the caller
set -u
. "$EVAL_ROOT/evals/_lib/notify.sh"
write_notify_env
body=$(head -c 2000 /dev/zero | tr '\0' 'x')
out=$(bash "$NOTIFY_SH" finished "t" "$body" 2>&1); rc=$?; echo "rc=$rc out=[$out]"
[ "$rc" -eq 0 ] || fail "exit $rc"
n=$(curl_calls); echo "curl calls: $n"; [ "$n" -eq 1 ] || fail "expected one curl call, got $n"
sz=$(cat "$CURL_DIR"/call.*/body | wc -c); echo "body bytes: $sz"
[ "$sz" -gt 0 ] || fail "empty body: the title/body arguments were not delivered"
[ "$sz" -le 500 ] || fail "body is $sz bytes, expected <= 500"
curl_all_headers | grep -qi '^Markdown:[[:space:]]*yes' && fail "Markdown: yes header sent"
curl_all_headers | grep -qi 'tk_secrettoken123' || fail "token not sent as authentication"
echo "$out" | grep -q tk_secrettoken123 && fail "token printed"
echo OK
