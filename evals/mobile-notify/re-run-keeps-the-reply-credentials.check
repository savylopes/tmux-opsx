#!/usr/bin/env bash
# scenario: mobile-notify / Re-run keeps the reply credentials
# level: L2
# requirement: ntfy credentials
set -u
. "$EVAL_ROOT/evals/_lib/actions.sh"
notify_install_ok dev.example.com
t1=$(grep '^NTFY_REPLY_TOKEN=' "$NOTIFY_ENV"); p1=$(grep '^NTFY_REPLY_TOPIC=' "$NOTIFY_ENV"); echo "$p1"
[ -n "${t1#NTFY_REPLY_TOKEN=}" ] && [ -n "${p1#NTFY_REPLY_TOPIC=}" ] || fail "reply token or topic empty after first install"
notify_install_ok dev.example.com
t2=$(grep '^NTFY_REPLY_TOKEN=' "$NOTIFY_ENV"); p2=$(grep '^NTFY_REPLY_TOPIC=' "$NOTIFY_ENV")
[ "$t1" = "$t2" ] || fail "NTFY_REPLY_TOKEN changed on re-run"
[ "$p1" = "$p2" ] || fail "NTFY_REPLY_TOPIC changed on re-run"
n=$(grep -cE '^ntfy user .*add .*opsx-reply' "$FAKE_NTFY_LOG"); echo "opsx-reply user add calls: $n"
[ "$n" -eq 1 ] || fail "expected exactly one 'ntfy user add opsx-reply', got $n"
echo OK
