#!/usr/bin/env python3
# scenario: mobile-notify / Dispatcher prompt says to mark ask
# level: L1
# requirement: Prompts mark ask before asking
import os, re, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.environ["EVAL_ROOT"], "evals", "_lib"))
from skill_prompts import prompt, fail
va = "\n".join(prompt("validate"))
print(va)
if not re.search(r"opsx-window\.sh\s+mark\s+<change>\s+ask", va):
    fail("validate dispatcher prompt does not tell the agent to run `opsx-window.sh mark <change> ask`")
i = va.find("mark <change> ask")
if not re.search(r"(before|prior to)[^.]*(ask|question)|(ask|question)[^.]*after", va[max(0, i - 400): i + 400], re.I):
    fail("prompt does not say to mark ask BEFORE asking the user")
print("OK")
