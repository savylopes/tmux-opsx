#!/usr/bin/env bash
# scenario: mobile-notify / Info hides the password
# level: L2
# requirement: Notification config
set -u
. "$EVAL_ROOT/evals/_lib/notify.sh"
notify_install_ok dev.example.com
pw=$(sed -n 's/^NTFY_PASSWORD=//p' "$NOTIFY_ENV" | tr -d "\"'"); tok=$(sed -n 's/^NTFY_TOKEN=//p' "$NOTIFY_ENV" | tr -d "\"'"); topic=$(sed -n 's/^NTFY_TOPIC=//p' "$NOTIFY_ENV")
[ -n "$pw" ] && [ -n "$tok" ] || { echo "install did not store a password and token to look for"; exit 77; }
out=$("$EVAL_ROOT/bin/opsx" notify info 2>&1); rc=$?; echo "rc=$rc"; echo "$out"
[ "$rc" -eq 0 ] || fail "opsx notify info exited $rc"
echo "$out" | grep -q "https://ntfy.dev.example.com" || fail "URL not printed"
echo "$out" | grep -qw opsx || fail "user opsx not printed"
echo "$out" | grep -qF "$topic" || fail "topic not printed"
echo "$out" | grep -qF "$pw" && fail "password printed"
echo "$out" | grep -qF "$tok" && fail "token printed"
echo OK
