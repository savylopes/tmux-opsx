#!/usr/bin/env bash
# scenario: notify-actions / PR answer typed once
# level: L2
# requirement: Listener delivers a valid reply once
set -u
. "$EVAL_ROOT/evals/_lib/actions.sh"
need_json; write_notify_env_reply; start_tmux
read -r w p < <(typed_win pr-42 line)
pr_setup 42
pr_note "$p" 42 "main or develop?" --option main --option develop >/dev/null
wait_calls 1 10 || fail "no push"; sleep 1; n=$(last_nonce); reset_curl
[ -n "$n" ] || fail "no nonce in the push"
stream_live 1 "$n:2" "$n:2"
start_listener 6; sleep 3.5; stop_listener
[ -d "$SUB_DIR/c1" ] || fail "listener never subscribed"
printf 'typed bytes: '; od -c "$EVAL_TMP/typed.pr-42" | head -3
[ "$(cat "$EVAL_TMP/typed.pr-42")" = "develop" ] && [ "$(wc -l < "$EVAL_TMP/typed.pr-42")" -eq 1 ] || fail "expected exactly one line 'develop'"
echo OK
