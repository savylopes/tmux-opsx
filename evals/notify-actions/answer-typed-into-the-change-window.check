#!/usr/bin/env bash
# scenario: notify-actions / Answer typed into the change window
# level: L2
# requirement: PR buttons for a change window maintaining a PR
set -u
. "$EVAL_ROOT/evals/_lib/actions.sh"
need_json; write_notify_env_reply; start_tmux
read -r w p < <(typed_win add-thing line)
TM set-option -w -t "$w" @opsx_pr 42; TM set-option -w -t "$w" @opsx_pr_repo acme/api
pr_setup 42
pr_note "$p" 42 "q" --option main --option develop >/dev/null
wait_calls 1 10 || fail "no push"; sleep 1; n=$(last_nonce); reset_curl
[ -n "$n" ] || fail "no nonce in the push"
stream_live 1 "$n:2" "$n:2"
start_listener 6; sleep 3.5; stop_listener
[ -d "$SUB_DIR/c1" ] || fail "listener never subscribed"
printf 'typed bytes: '; od -c "$EVAL_TMP/typed.add-thing" | head -3
[ "$(cat "$EVAL_TMP/typed.add-thing")" = "develop" ] && [ "$(wc -l < "$EVAL_TMP/typed.add-thing")" -eq 1 ] || fail "expected exactly one line 'develop'"
echo OK
