#!/usr/bin/env bash
# scenario: notify-actions / Expired nonce
# level: L2
# requirement: Live nonce
set -u
. "$EVAL_ROOT/evals/_lib/actions.sh"
need_json; write_notify_env_reply; start_tmux
read -r w p < <(typed_win pr-42 line)
pr_setup 42
pr_note "$p" 42 "main or develop?" --option main --option develop >/dev/null
wait_calls 1 10 || fail "no push"; sleep 1; n=$(last_nonce)
rec=$(TM show-options -wqv -t "$w" @opsx_notify_reply); echo "record: [$rec]"
[ -n "$rec" ] || fail "no @opsx_notify_reply record on the asking window"
case $rec in "$n "*) ;; *) fail "record does not start with the push's nonce";; esac
# record time: the 2nd field, an epoch; make it 2 hours old
new=$(echo "$rec" | awk -v t=$(( $(date +%s) - 7200 )) '{$2=t; print}')
TM set-option -w -t "$w" @opsx_notify_reply "$new"
reset_curl; stream_live 1 "$n:1"
start_listener 6; sleep 3.5; stop_listener
[ -d "$SUB_DIR/c1" ] || fail "listener never subscribed"
t=$(typed pr-42); echo "typed=[$t]"
[ -z "$t" ] || fail "an expired nonce typed into the pane"
echo OK
