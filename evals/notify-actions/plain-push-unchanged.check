#!/usr/bin/env bash
# scenario: notify-actions / Plain push unchanged
# level: L2
# requirement: At most three buttons per push
set -u
. "$EVAL_ROOT/evals/_lib/actions.sh"
write_notify_env_reply; start_tmux
read -r w p < <(new_win fix-x change)
export OPSX_NOTIFY_FLUSH_AFTER=1
out=$(TMUX_PANE=$p bash "$WINSH" mark fix-x done 2>&1); rc=$?; echo "rc=$rc out=[$out]"
[ "$rc" -eq 0 ] || fail "mark exit $rc"
wait_calls 1 20 || fail "no finished push within 20 s"; sleep 1
curl_all_headers; curl_all_bodies; echo
has_actions_header && fail "plain push has an Actions header"
echo OK
