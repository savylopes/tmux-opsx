#!/usr/bin/env bash
# scenario: notify-actions / Note with options
# level: L2
# requirement: Answer buttons for a PR question
set -u
. "$EVAL_ROOT/evals/_lib/actions.sh"
need_json; write_notify_env_reply; start_tmux
read -r w p < <(new_win pr-42 change)
pr_setup 42
out=$(pr_note "$p" 42 "rebase onto main or develop?" --option main --option develop); rc=$?; echo "rc=$rc out=[$out]"
[ "$rc" -eq 0 ] || fail "note exit $rc"
wait_calls 1 10 || fail "no push"; sleep 1
actions_tsv
[ "$(actions_tsv | awk -F'\t' '$1=="http"{printf "%s,",$2}')" = "main,develop," ] || fail "expected two http actions labelled main and develop"
grep -q '^ask=' "$(pr_state_dir 42)/state" || { cat "$(pr_state_dir 42)/state"; fail "no ask= line in the state file"; }
echo OK
