#!/usr/bin/env bash
# scenario: notify-actions / No reply config, no answer buttons
# level: L2
# requirement: Answer button posts a nonce to the reply topic
set -u
. "$EVAL_ROOT/evals/_lib/actions.sh"
write_notify_env; start_tmux
read -r w p < <(new_win pr-42 change)
pr_setup 42
pr_note "$p" 42 "pick" --option a --option b >/dev/null
wait_calls 1 10 || fail "no push was sent"; sleep 1
curl_all_headers
[ "$(actions_tsv | awk -F'\t' '$1=="http"' | wc -l)" -eq 0 ] || fail "http actions without reply config"
echo OK
