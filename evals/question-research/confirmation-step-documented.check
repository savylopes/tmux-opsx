#!/usr/bin/env bash
# scenario: question-research / Confirmation step documented
# level: L1
# requirement: The user confirms the question list
set -u
. "$EVAL_ROOT/evals/_lib/questions.sh"
for s in answer challenge settle; do
  f="$EVAL_ROOT/skills/opsx-$s/SKILL.md"; [ -f "$f" ] || fail "$f missing"
  grep -Eiq 'confirm' "$f" || fail "opsx-$s: no confirmation"
  grep -Eiq 'do not (start|run|launch)[^.]*(subagent|research)[^.]*before[^.]*confirm|before (any|starting|you start|launching|running)[^.]*(subagent|research)|(subagent|research)[^.]*(until|only after)[^.]*confirm|no (subagent|research)[^.]*(without|until)' "$f" || fail "opsx-$s: does not say confirmation comes before any subagent"
done
echo OK
