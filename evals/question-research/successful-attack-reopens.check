#!/usr/bin/env bash
# scenario: question-research / Successful attack reopens
# level: L1
# requirement: Settle state machine
set -u
. "$EVAL_ROOT/evals/_lib/questions.sh"
mk_repo; new_run settle 1
rec Q1 --round 1 --stage answer --verdict answered || fail rec1
rec Q1 --round 1 --stage challenge-a --verdict invalidated --sources 1 || fail rec2
rec Q1 --round 1 --stage challenge-b --verdict stands --sources 1 || fail rec3
s=$(st); echo "$s"; echo "$s" | grep -Eq '^Q1 open round=2( |$)' || fail "unexpected status"
echo OK
