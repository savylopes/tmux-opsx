#!/usr/bin/env bash
# scenario: explain-page / Secrets forbidden
# level: L2
# requirement: No secrets in pages
. "$EVAL_ROOT/evals/_lib/explain.sh"
run_explain open x; [ $RC -eq 0 ] || fail "$OUT"
sec=$(sed -n '/[Pp]age protocol/,$p' "$(fdir 1)/brief.md"); [ -n "$sec" ] || fail "no page protocol"
grep -qiE '(never|not|no).{0,60}secret' <<<"$sec" || fail "no never-secrets rule"
grep -qi 'token' <<<"$sec" && grep -qiE 'credential' <<<"$sec" || fail "does not name tokens and credentials"
echo ok
