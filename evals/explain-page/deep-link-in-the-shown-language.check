#!/usr/bin/env bash
# scenario: explain-page / Deep link in the shown language
# level: L1
# requirement: Language switch
# Runs the template's inline language script in a minimal DOM stand-in (no browser available).
. "$EVAL_ROOT/evals/_lib/explain.sh"
command -v node >/dev/null || { echo "needs node"; exit 77; }
template > "$EVAL_TMP/t.html"; [ -s "$EVAL_TMP/t.html" ] || fail "no template"
r=$(node "$EVAL_ROOT/evals/_lib/langsim.js" "$EVAL_TMP/t.html" '{"search":"?lang=pt","hash":"#P1","navlang":"en-US","stored":"en"}') || fail "sim error: $r"
echo "$r"
j() { node -e 'const o=JSON.parse(process.argv[1]);console.log(eval("o."+process.argv[2]))' "$r" "$1"; }
[ "$(j shown)" = pt ] || fail "Portuguese not shown for ?lang=pt"
[ "$(j 'idOwners.P1.length')" = 1 ] || fail "not exactly one element with id P1"
[ "$(j 'idOwners.P1[0]')" = pt ] || fail "P1 id is not the Portuguese one"
[ "$(j target)" = "pt:P1" ] || fail "fragment did not land on the Portuguese P1 (got $(j target))"
echo ok
