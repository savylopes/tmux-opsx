#!/usr/bin/env bash
# scenario: task-session / Resume by id
# level: L2
# requirement: Return to a task
set -u
. "$EVAL_ROOT/evals/_lib/task.sh"
mkbrief MED-43 jira:MED-43
"$TASK" start MED-43 --agent-cli claude --no-switch --repo "$R" >/dev/null 2>&1 || fail "start failed"
wait_args claude >/dev/null
u=$(hdr MED-43 session_id); [ -n "$u" ] || fail "no session_id recorded"
T kill-session -t =MED-43; rm -f "$FAKE_LOG/claude.args"
out=$("$TASK" open MED-43 --no-switch --repo "$R" 2>&1); rc=$?; echo "$out"
[ $rc -eq 0 ] || fail "open exit $rc"
T has-session -t =MED-43 || fail "no new session"
a=$(wait_args claude); echo "args: $a"
r=$(grep -nx -- '-r' "$FAKE_LOG/claude.args" | cut -d: -f1 | head -1); [ -n "$r" ] || fail "no -r"
[ "$(sed -n "$((r+1))p" "$FAKE_LOG/claude.args")" = "$u" ] || fail "-r not followed by $u"
