#!/usr/bin/env bash
# scenario: session-restore / Finished or waiting windows only resumed
# level: L2
# requirement: Continue an unfinished change window
set -u
. "$EVAL_ROOT/evals/_lib/sessions.sh"

server a work "$R1"
IDS=(x 11111111-1111-4111-8111-111111111111 22222222-2222-4222-8222-222222222222 33333333-3333-4333-8333-333333333333 44444444-4444-4444-8444-444444444444 55555555-5555-4555-8555-555555555555)
i=1
for st in idle done fail ask; do
  claude_win work:$((i+1)) w$i "$R1" "$(hook_json ${IDS[$i]} "$R1" bypassPermissions)"
  wopt work:$((i+1)) @opsx_change chg$i; wopt work:$((i+1)) @opsx_status $st
  i=$((i+1))
done
claude_win work:6 w5 "$R1" "$(hook_json ${IDS[5]} "$R1" bypassPermissions)"   # no @opsx_change
wopt work:6 @opsx_status busy
sess_run save; [ $RC -eq 0 ] || fail "save exit $RC"
restart b work "$R2"
for k in 2 3 4 5 6; do bash_win work:$k w$k "$R2"; done
sess_run restore; [ $RC -eq 0 ] || fail "restore exit $RC"
for k in 1 2 3 4 5; do
  id=${IDS[$k]}; stub_args $id; show_args; bare_args
  [ "${#BARE[@]}" -eq 2 ] && [ "${BARE[0]}" = --resume ] && [ "${BARE[1]}" = $id ] || fail "$id got a prompt or other args"
done
echo OK
