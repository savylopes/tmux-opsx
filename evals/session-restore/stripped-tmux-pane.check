#!/usr/bin/env bash
# scenario: session-restore / Stripped TMUX_PANE
# level: L2
# requirement: Record the conversation running in a pane
set -u
. "$EVAL_ROOT/evals/_lib/sessions.sh"

server a work "$R1"
STRIP_PANE=1 claude_win work:2 w2 "$R1" "$(hook_json $UUID1 "$R1" bypassPermissions)"
[ "$(cat $RUNS/$LASTRUN.rc)" = 0 ] || fail "hook exit"
sess_run list --live
echo "$OUT" | grep -F 'work:2.0' | grep -qF "$UUID1" || fail "pane not recorded without TMUX_PANE"
echo OK
