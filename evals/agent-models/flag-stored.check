#!/usr/bin/env bash
# scenario: agent-models / Flag stored
# level: L2
# requirement: Flag choices are remembered on the window
set -u
. "$EVAL_ROOT/evals/_lib/models.sh"
run_w ensure c1 --prompt-file p --qa-model haiku
[ "$RC" -eq 0 ] || fail "ensure exited $RC"
w=$(win_of c1); [ -n "$w" ] || fail "no window for c1"
echo "model options:"; model_opts "$w"
[ "$(win_opt "$w" @opsx_model_qa)" = haiku ] || fail "@opsx_model_qa is '$(win_opt "$w" @opsx_model_qa)', expected haiku"
win_has_opt "$w" @opsx_model_reviewer && fail "@opsx_model_reviewer is set"
echo OK
