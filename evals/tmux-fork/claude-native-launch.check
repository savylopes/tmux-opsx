#!/usr/bin/env bash
# scenario: tmux-fork / Claude native launch
# level: L2
# requirement: Native fork
. "$EVAL_ROOT/evals/_lib/fork.sh"
export FORK_HOST_CLI=claude CLAUDE_CODE_SESSION_ID=$SID
open_fork --cli claude; [ $RC -eq 0 ] || fail "open: $OUT"
a=$(wait_args claude)
has_arg claude --resume || fail "no --resume: $a"
grep -qx -A0 -- "$SID" "$FAKE_LOG/claude.args" || fail "no session id arg: $a"
[ "$(grep -x -A1 -- '--resume' "$FAKE_LOG/claude.args" | sed -n 2p)" = "$SID" ] || fail "--resume not followed by $SID: $a"
has_arg claude --fork-session || fail "no --fork-session: $a"
has_arg claude --permission-mode || fail "no --permission-mode"
[ "$(grep -x -A1 -- '--permission-mode' "$FAKE_LOG/claude.args" | sed -n 2p)" = plan ] || fail "mode not plan: $a"
grep -q 'what does foo do' "$FAKE_LOG/claude.args" || fail "brief not passed"
grep -qE -- '^--(dangerously-skip-permissions|allow-dangerously-skip-permissions)$|bypassPermissions' "$FAKE_LOG/claude.args" && fail "bypass flag present: $a"
echo ok
