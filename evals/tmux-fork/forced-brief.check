#!/usr/bin/env bash
# scenario: tmux-fork / Forced brief
# level: L2
# requirement: Fallback to brief mode
. "$EVAL_ROOT/evals/_lib/fork.sh"
export FORK_HOST_CLI=claude CLAUDE_CODE_SESSION_ID=$SID
open_fork --cli claude --brief-only; [ $RC -eq 0 ] || fail "open: $OUT"
a=$(wait_args claude)
has_arg claude --resume && fail "--resume present: $a"
has_arg claude --fork-session && fail "--fork-session present: $a"
# FORK_NATIVE=0 as well
rm -f "$FAKE_LOG/claude.args"
FORK_NATIVE=0 open_fork --cli claude; [ $RC -eq 0 ] || fail "open2: $OUT"
a=$(wait_args claude)
has_arg claude --resume && fail "FORK_NATIVE=0: --resume present: $a"
echo ok
