#!/usr/bin/env bash
# scenario: tmux-fork / No marker fallback for pages
# level: L2
# requirement: Page command allowed in read-only mode
. "$EVAL_ROOT/evals/_lib/fork.sh"
open_fork --cli claude --page-dir /x/3; [ $RC -eq 0 ] || fail "open: $OUT"
sec=$(sed -n '/[Pp]age protocol/,$p' "$(fdir 1)/brief.md")
[ -n "$sec" ] || fail "no page protocol section"
grep -qiE 'stop' <<<"$sec" || fail "no stop instruction"
grep -qiE 'cannot be written|blocked|refused' <<<"$sec" || fail "no report-when-blocked instruction"
grep -q '<<<FORK-RESULT' <<<"$sec" && fail "page protocol mentions result markers"
grep -qiE 'do not print the HTML|not print the html' <<<"$sec" || fail "does not forbid printing HTML"
echo ok
