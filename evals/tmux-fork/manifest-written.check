#!/usr/bin/env bash
# scenario: tmux-fork / Manifest written
# level: L2
# requirement: Page write from the child
. "$EVAL_ROOT/evals/_lib/fork.sh"
d="$EVAL_TMP/x/3"; mkdir -p "$d"; echo ORIGINAL > "$d/index.html"
OUT=$(printf 'P1\tfirst\nS1\tsec\n' | FORK_PAGE_DIR="$d" FORK_DIR="$EVAL_TMP/nofork" "$FORK" page --manifest 2>&1); RC=$?
[ $RC -eq 0 ] || fail "rc=$RC: $OUT"
grep -qP '^P1\tfirst$' "$d/manifest.tsv" && grep -qP '^S1\tsec$' "$d/manifest.tsv" || fail "manifest content: $(cat "$d/manifest.tsv")"
[ "$(cat "$d/index.html")" = ORIGINAL ] || fail "index.html touched"
echo ok
