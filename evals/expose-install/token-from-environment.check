#!/usr/bin/env bash
# scenario: expose-install / Token from environment
# level: L2
# requirement: Token intake
set -u
. "$EVAL_ROOT/evals/_lib/expose.sh"
out=$(CLOUDFLARE_API_TOKEN=t1 OPSX_EXPOSE_SKIP_VERIFY=1 OPSX_CADDY_BIN="$FAKE_CADDY" expose_install dev.example.com); rc=$?
echo "install exit $rc"; echo "$out" | tail -10
[ "$rc" -eq 0 ] || fail "install.sh exited $rc"
grep -Eq "^[A-Z_]*TOKEN[A-Z_]*=[\"']?t1[\"']?$" "$ENV_FILE" || fail "stored token is not t1"
if echo "$out" | grep -Ei '(enter|paste|type|input).*token|token[^\n]*: *$'; then fail "a token prompt was shown"; fi
echo OK
