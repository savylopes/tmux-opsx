#!/usr/bin/env bash
# scenario: expose-install / Rejected token
# level: L2
# requirement: Token verification
set -u
. "$EVAL_ROOT/evals/_lib/expose.sh"
# local stand-in for the Cloudflare API answering like it does for a bad token
cat > "$EVAL_TMP/cf.py" <<'PY'
import http.server, sys
class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def do_GET(self):
        b = b'{"success":false,"errors":[{"code":1000,"message":"Invalid API Token"}],"messages":[],"result":null}'
        self.send_response(401); self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(b))); self.end_headers(); self.wfile.write(b)
s = http.server.HTTPServer(("127.0.0.1", 0), H)
open(sys.argv[1], "w").write(str(s.server_port)); s.serve_forever()
PY
python3 -I "$EVAL_TMP/cf.py" "$EVAL_TMP/cf.port" & cfpid=$!
trap 'kill $cfpid 2>/dev/null; _expose_cleanup' EXIT
for _ in $(seq 50); do [ -s "$EVAL_TMP/cf.port" ] && break; sleep 0.1; done
export OPSX_CLOUDFLARE_API="http://127.0.0.1:$(cat "$EVAL_TMP/cf.port")/client/v4"
# 1) fresh: no expose.env must be created
out=$(CLOUDFLARE_API_TOKEN=bad1 OPSX_CADDY_BIN="$FAKE_CADDY" expose_install dev.example.com); rc=$?
echo "fresh: exit $rc"; echo "$out" | tail -5
[ "$rc" -ne 0 ] || fail "expected non-zero exit for a rejected token"
echo "$out" | grep -qi 'invalid' || fail "message does not say the token is invalid"
[ ! -e "$ENV_FILE" ] || fail "expose.env was created"
# 2) existing config: must stay unchanged
configure_expose
sum=$(sha256sum "$ENV_FILE")
out=$(CLOUDFLARE_API_TOKEN=bad2 OPSX_CADDY_BIN="$FAKE_CADDY" expose_install dev.example.com); rc=$?
echo "existing: exit $rc"; echo "$out" | tail -3
[ "$rc" -ne 0 ] || fail "expected non-zero exit for a rejected token (existing config)"
[ "$(sha256sum "$ENV_FILE")" = "$sum" ] || fail "expose.env changed after a rejected token"
grep -q "$OPSX_CLOUDFLARE_API" "$SHIM_LOG" || fail "the verify API was never called"
echo OK
