#!/usr/bin/env bash
# scenario: expose-install / Non-root Linux
# level: L2
# requirement: Privileged step
set -u
. "$EVAL_ROOT/evals/_lib/expose.sh"
[ "$(uname -s)" = Linux ] || { echo "not Linux"; exit 77; }
[ "$(id -u)" -ne 0 ] || { echo "running as root; scenario needs a non-root user"; exit 77; }
out=$(CLOUDFLARE_API_TOKEN=t1 OPSX_EXPOSE_SKIP_VERIFY=1 OPSX_CADDY_BIN="$FAKE_CADDY" expose_install dev.example.com); rc=$?
echo "install exit $rc"; echo "$out" | tail -15
[ "$rc" -eq 0 ] || fail "install.sh exited $rc"
unit=$(find "$XDG_CONFIG_HOME" -name '*.service' | head -1); [ -n "$unit" ] || fail "no systemd unit under $XDG_CONFIG_HOME"
echo "unit: $unit"
if grep -E '^(sudo|systemctl) ' "$SHIM_LOG"; then fail "install.sh invoked sudo/systemctl"; fi
ub=$(basename "$unit")
echo "$out" | grep -F "$ub" >/dev/null || fail "output does not mention the unit $ub"
echo "$out" | grep -E 'systemctl.*(enable.*--now|start)' || fail "output lacks a command that enables/starts the unit"
echo OK
