#!/usr/bin/env python3
# scenario: opsx-validate-pipeline / Review fails then passes
# level: L1
# requirement: validate loop retries failed gates via applier
import os, re, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.environ["EVAL_ROOT"], "evals", "_lib"))
from skill_prompts import prompt, steps, first_step, goto_targets, fail, show

va = prompt("validate"); show(va)
st = steps(va)
r = first_step(st, r"delegate[^.]*ops-reviewer")
sec = first_step(st, r"delegate[^.]*ops-security")
qa = first_step(st, r"delegate[^.]*ops-qa")
f = first_step(st, r"review\W*FAIL")
if None in (r, sec, qa, f):
    fail("validate prompt lacks review/security/qa steps or a review-FAIL rule")
s = st[f]; print("review FAIL rule (step %d): %s" % (f, s))
if not re.search(r"ops-applier", s) or not re.search(r"F1, F2|verbatim", s):
    fail("review FAIL does not delegate ops-applier to fix F1, F2 verbatim")
if goto_targets(s) != [r]:
    fail("review FAIL does not re-run only ops-reviewer (targets %s, review step %d)" % (goto_targets(s), r))
if not (r < sec < qa):
    fail("security/qa not after review")
if not re.search(r"review\W*PASS\W*or\W*SKIP\W*(?:→|->)\s*step %d" % sec, s, re.I):
    fail("security is not gated on review PASS or SKIP")
print("OK")
