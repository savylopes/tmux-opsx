#!/usr/bin/env python3
# scenario: opsx-validate-pipeline / Eval runs before review
# level: L1
# requirement: validate loop includes review and security gates
import os, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.environ["EVAL_ROOT"], "evals", "_lib"))
from skill_prompts import prompt, steps, first_step, fail, show

va = prompt("validate"); show(va)
st = steps(va)
a = first_step(st, r"ops-applier")
e = first_step(st, r"delegate[^.]*ops-eval")
r = first_step(st, r"delegate[^.]*ops-reviewer")
print("apply step %s, eval step %s, review step %s" % (a, e, r))
if None in (a, e, r):
    fail("validate prompt lacks an apply, eval or review delegation step")
if not a < e < r:
    fail("ops-eval does not run after apply and before ops-reviewer")
print("OK")
