#!/usr/bin/env python3
# scenario: opsx-validate-pipeline / Goal text reflects new gates
# level: L1
# requirement: validate goal includes all gates
import os, re, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.environ["EVAL_ROOT"], "evals", "_lib"))
from skill_prompts import prompt, fail, show

va = prompt("validate")
goal = [l for l in va if re.search(r"CreateGoal", l)]
if not goal:
    show(va); fail("validate prompt has no CreateGoal / goal text")
g = goal[0]; print(g)
for gate in ("eval", "review", "security", "qa"):
    if not re.search(r"ops-%s|\b%s\b" % (gate if gate != "review" else "reviewer", gate), g, re.I):
        fail("goal text does not mention %s" % gate)
if not re.search(r"PASS", g) or not re.search(r"SKIP", g):
    fail("goal text does not require PASS or SKIP")
print("OK")
